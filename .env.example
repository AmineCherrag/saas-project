# ==============================================================================
# TradePulse SaaS Platform - Production & Development Environment Template
# ==============================================================================

# Application & Host Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://saas-project-gamma-two.vercel.app
PORT=3000

# Authentication & Session Security
JWT_SECRET=super-secret-jwt-signing-key-change-in-production-at-least-32-chars
SESSION_COOKIE_NAME=tradepulse_session
SESSION_DURATION_DAYS=30
BCRYPT_SALT_ROUNDS=12

# Database Connection (PostgreSQL for Vercel/Production SaaS)
# Connect to your managed PostgreSQL instance (Vercel Postgres, Neon, Supabase, or AWS RDS):
DATABASE_URL="postgresql://username:password@ep-example.us-east-1.aws.neon.tech/tradepulse?sslmode=require"
# For local offline development fallback only:
# DATABASE_URL="file:./data/tradepulse.db"
DATA_DIRECTORY_PATH=./data

# Stripe Payment Gateway (TEST Mode Only)
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_here
STRIPE_STARTER_MONTHLY_PRICE_ID=price_starter_mo_test
STRIPE_STARTER_YEARLY_PRICE_ID=price_starter_yr_test
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_mo_test
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yr_test
STRIPE_ELITE_MONTHLY_PRICE_ID=price_elite_mo_test
STRIPE_ELITE_YEARLY_PRICE_ID=price_elite_yr_test

# Email & Notification Services (Optional - SMTP / SendGrid / Postmark)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=placeholder_smtp_key
SMTP_FROM_EMAIL=support@tradepulse.io

# AI Mentor & Quantitative Model Integration (Optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Storage & Screenshot Attachments (Optional - AWS S3 / Cloudflare R2)
S3_BUCKET_NAME=tradepulse-chart-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ==============================================================================
# TradePulse SaaS Platform - Environment Configuration Template
# ==============================================================================

# Application & Host Configuration
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://app.tradepulse.io
PORT=3000

# Authentication & Session Security
JWT_SECRET=super-secret-jwt-signing-key-change-in-production
SESSION_COOKIE_NAME=tradepulse_session
SESSION_DURATION_DAYS=30
BCRYPT_SALT_ROUNDS=12

# Stripe Payment Gateway (Live & Sandbox)
STRIPE_SECRET_KEY=sk_test_51...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_MONTHLY_PRICE_ID=price_starter_mo_...
STRIPE_STARTER_YEARLY_PRICE_ID=price_starter_yr_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_mo_...
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yr_...
STRIPE_ELITE_MONTHLY_PRICE_ID=price_elite_mo_...
STRIPE_ELITE_YEARLY_PRICE_ID=price_elite_yr_...

# Multi-Tenant Database Connection
DATABASE_URL=file:./data/tradepulse.db
DATA_DIRECTORY_PATH=./data

# Email & Notification Services (SMTP / Postmark / SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your-api-key-here
SMTP_FROM_EMAIL=support@tradepulse.io

# AI Mentor & Quantitative Model Integration (Optional)
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...

# Storage & Screenshot Attachments (AWS S3 / Cloudflare R2)
S3_BUCKET_NAME=tradepulse-chart-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=AKIA...
S3_SECRET_ACCESS_KEY=...
